{
  "name": "owd-nuxt-desktop",
  "private": true,
  "description": "Open Web Desktop Nuxt workspace",
  "homepage": "https://github.com/owdproject/nuxt-desktop#readme",
  "bugs": {
    "url": "https://github.com/owdproject/nuxt-desktop/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owdproject/nuxt-desktop.git"
  },
  "license": "MIT",
  "author": {
    "name": "Open Web Desktop Team",
    "url": "https://github.com/owdproject"
  },
  "scripts": {
    "dev": "pnpm --dir desktop dev",
    "generate": "pnpm --dir desktop generate",
    "desktop": "pnpm exec desktop",
    "prepare:stubs": "node scripts/prepare-stubs.mjs",
    "prepare:modules": "pnpm run prepare:stubs && pnpm -r --filter \"./apps/*\" --if-present run dev:prepare",
    "prepare:apps": "pnpm -r --filter \"./apps/*\" --if-present run dev:prepare",
    "prepare:themes": "pnpm -r --filter \"./themes/*\" --if-present run dev:prepare"
  },
  "devDependencies": {}
}
